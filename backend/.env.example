DATABASE_URL=postgres://postgres:postgres@localhost:5432/systems_db

# Clave secreta global para tokens internos si se requieren
JWT_SECRET=super_secret_jwt_key_ecosistema_systems_2026

# Origen permitido para CORS (Frontend)
CORS_ORIGIN=*
